<CsoundSynthesizer>

<CsOptions>
-odac   ;-M0 -b128   -B256
</CsOptions>

<CsInstruments>
; ########## CONFIG ##########
sr      = 44100 ; sample rate
kr      = 4410 ; control rate
nchnls  = 2 ; number of channels
0dbfs   = 1 ; maximum amplitude (0dB)
; ########## CONFIG ##########
</CsInstruments>

<CsScore>
</CsScore>

</CsoundSynthesizer>
